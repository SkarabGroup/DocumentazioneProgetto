@startuml C4_Component_Mega_Hexagonal_FinalS
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

skinparam linetype ortho
skinparam nodesep 200
skinparam ranksep 200

title Diagramma Integrale - CodeGuardian Analysis Microservice (Dettaglio Domain Core)

' --- SISTEMI ESTERNI ---
System_Ext(APIGateway, "Amazon API Gateway", "Ingresso, Throttling & VPC Link")
System_Ext(GitHub, "GitHub API", "Source Code (HTTPS)")
System_Ext(AWSBedrock, "AWS Bedrock", "LLM per Remediation")
ContainerDb_Ext(MongoDB, "MongoDB Atlas", "Report, Audit & PAT Utenti")
System_Ext(AWSS3, "AWS S3", "Storage ZIP (Shards) & Risultati JSON")

' --- SICUREZZA INFRASTRUTTURALE ---
Component(LambdaAuthorizer, "Lambda Authorizer", "AWS Lambda", "Controlla solo la validità del JWT")

Container_Boundary(AnalysisMicroservice, "Analysis Microservice (Fargate)") {

    Container_Boundary(NestJS, "NestJS Orchestrator") {
        
        Boundary(PrimaryAdapters, "Inbound Adapters") #FFF2CC {
            Component(AnalysisController, "Analysis Controller", "NestJS", "POST /analysis")
            Component(ReportController, "Report Controller", "NestJS", "GET /analysis/:id")
            Component(WebhookController, "Webhook Controller", "NestJS", "POST /webhooks/stn-callback")
            Component(HealthController, "Health Controller", "NestJS", "GET /health")
        }

        Boundary(DomainCore, "Domain Core (Esagono)") #E6F3FF {
            Boundary(InputPorts, "Input Ports (Use Cases)") #CEADF0 {
                Component(IAnalysisUseCase, "IAnalysisUseCase", "Interface")
                Component(ICallbackUseCase, "ICallbackUseCase", "Interface")
                Component(IDatabaseUseCase, "IDatabaseUseCase", "Interface")
            }

            ' Scomposizione in servizi SRP
            Component(AnalysisOrchestrator, "Analysis Orchestrator", "Application Service", "Coordina il flusso")
            Component(CacheService, "Cache Service", "Domain Service", "Verifica Idempotenza e SHA")
            Component(PreparationEngine, "Preparation Engine", "Domain Service", "Gestione Clone & Workflow")
            Component(PackagerEngine, "Packager Engine", "Domain Service", "Scan, Shard & Cleanup")
            Component(DatabaseService, "Database Service", "Domain Service", "Logica di persistenza e rimodellazione")
            
            Boundary(OutputPorts, "Output Ports") #E6DED3 {
                Component(ISourceControlPort, "ISourceControlPort", "Interface")
                Component(IStoragePort, "IStoragePort", "Interface")
                Component(IWorkflowPort, "IWorkflowPort", "Interface")
                Component(IDatabasePort, "IDatabasePort", "Interface")
            }
        }

        Boundary(SecondaryAdapters, "Outbound Adapters") #D5E8D4 {
            Component(GitHubAdapter, "GitHub Adapter", "simple-git", "Interazioni Git")
            Component(S3Adapter, "S3 Adapter", "AWS SDK", "Upload/Download Shards")
            Component(StepFunctionsAdapter, "StepFunctions Adapter", "AWS SDK", "Trigger Workflow")
            Component(MongoDBAdapter, "MongoDB Adapter", "Mongoose", "Persistence")
        }

        Boundary(LocalFS, "Ephemeral Storage (/tmp)") #DDDDDD {
            ContainerDb(TempFolder, "Analysis Workspace", "File System", "Storage temporaneo codice")
        }
    }

    Container_Boundary(ServerlessLayer, "Serverless Execution Layer") #F8CECC {
        Component(StepFunctionsWorkflow, "Step Functions", "State Machine", "Orchestra gli Agenti")
        Component(SecurityScanAgent, "Security Scan Agent", "Lambda / Semgrep")
        Component(SecretsScanAgent, "Secrets Scan Agent", "Lambda / Trivy")
        Component(DependencyScanAgent, "Dependency Scan Agent", "Lambda / Syft")
        Component(DocumentationAgent, "Documentation Agent", "Lambda / Markdown")
        Component(ApiScanAgent, "Api Scan Agent", "Lambda / Spectral")
    }
}

' --- RELAZIONI ---

Rel_R(APIGateway, LambdaAuthorizer, "1. Verifica JWT")
Rel_D(APIGateway, AnalysisController, "2. HTTP Request")
Rel_D(APIGateway, ReportController, "HTTP Request")

' Inbound -> Core
Rel_D(AnalysisController, IAnalysisUseCase, "Avvia")
Rel_D(IAnalysisUseCase, AnalysisOrchestrator, "Implementato da")

Rel_D(AnalysisOrchestrator, CacheService, "Check Cache")
Rel_D(CacheService, ISourceControlPort, "Get SHA")
Rel_D(CacheService, IDatabaseUseCase, "Verify Idempotency")

Rel_R(AnalysisOrchestrator, PreparationEngine, "Delega Preparazione")
Rel_D(PreparationEngine, ISourceControlPort, "Clone")
Rel_D(ISourceControlPort, GitHubAdapter, "Usa")
Rel_D(GitHubAdapter, GitHub, "Clone API")
Rel_D(GitHubAdapter, TempFolder, "Scrive file")

Rel_D(PreparationEngine, PackagerEngine, "Innesca Sharding")
Rel_L(PackagerEngine, TempFolder, "Zippa & Pulisce")

Rel_D(PreparationEngine, IStoragePort, "Save Shards")
Rel_D(IStoragePort, S3Adapter, "Upload")
Rel_D(S3Adapter, AWSS3, "S3 Put")

Rel_D(PreparationEngine, IWorkflowPort, "Start Execution")
Rel_D(IWorkflowPort, StepFunctionsAdapter, "Trigger")
Rel_D(StepFunctionsAdapter, StepFunctionsWorkflow, "Start")

' Callback
Rel_U(StepFunctionsWorkflow, WebhookController, "Callback Risultati")
Rel_D(WebhookController, ICallbackUseCase, "Invia Payload")
Rel_D(ICallbackUseCase, AnalysisOrchestrator, "Implementato da")
Rel_D(AnalysisOrchestrator, IDatabaseUseCase, "Save Final Report")

' Persistence
Rel_D(DatabaseService, IDatabasePort, "Dati grezzi")
Rel_Up(DatabaseService, IDatabaseUseCase, "Implementa")
Rel_D(IDatabasePort, MongoDBAdapter, "Usa")
Rel_D(MongoDBAdapter, MongoDB, "Write/Read")

Rel_U(StepFunctionsWorkflow, SecurityScanAgent, "Call Agent")
Rel_R(StepFunctionsWorkflow, SecretsScanAgent, "Call Agent")
Rel_L(StepFunctionsWorkflow, DependencyScanAgent, "Call Agent")
Rel_D(StepFunctionsWorkflow, DocumentationAgent, "Call Agent")
Rel_U(StepFunctionsWorkflow, ApiScanAgent, "Call Agent")

@enduml