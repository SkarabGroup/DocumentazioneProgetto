@startuml
package "Hooks Layer (ViewModel)" {
  class useAnalysisSocket {
    + options.repositoryId?: string
    + options.onStarted?: (e) => void
    + options.onProgress?: (e) => void
    + options.onCompleted?: (e) => void
    + options.onFailed?: (e) => void
    --
    Custom hook che si iscrive agli eventi Socket.io del microservizio
    Analysis (analysis:started, analysis:progress, analysis:completed,
    analysis:failed). Filtra gli eventi per repositoryId se fornito.
    Su completamento mostra un toast di successo, su fallimento un toast
    di errore. Si de-iscrive automaticamente al dismount del componente.
  }

  useAnalysisSocket --> "SocketProvider" : consuma SocketContext
}
@enduml
