@startuml
package "API Layer (Model)" {
  class RepositoriesApi {
    + list(params): Promise<PaginatedResponse<Repository>>
    + get(id): Promise<Repository>
    + create(payload): Promise<Repository>
    + update(id, payload): Promise<Repository>
    + delete(id): Promise<void>
    + getRanking(): Promise<RankedRepository[]>
    + startAnalysis(id, payload): Promise<Analysis>
    + getHistory(id, params): Promise<PaginatedResponse<Analysis>>
    + compareAnalyses(id, ids): Promise<CompareResult>
    --
    Gestisce tutte le operazioni sui repository verso il microservizio
    Analysis: CRUD, avvio analisi, recupero storico per repository
    e classifica globale per score di qualità.
  }

  RepositoriesApi --> "Gateway" : usa
}
@enduml
