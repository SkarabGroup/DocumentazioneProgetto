@startuml
package "API Layer (Model)" {
  class AnalysisApi {
    + getById(id): Promise<Analysis>
    + getHistory(params): Promise<PaginatedResponse<Analysis>>
    + exportReport(id, format): Promise<Blob>
    + updateRemediationDecision(analysisId, remediationId, decision): Promise<void>
    --
    Recupera singoli report tramite GET /analysis/one con body { analysisId },
    mappando la risposta al tipo Analysis (meta-dati + DocsAnalysisReport).
    Gestisce lo storico globale, l'esportazione in json/pdf/csv/markdown
    e l'aggiornamento delle decisioni sulle remediation suggerite.
  }

  AnalysisApi --> "Gateway" : usa
}
@enduml
