@startuml C4_GitHub_Adapter

skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 90
skinparam classAttributeIconSize 0
hide circles

skinparam class {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 12
}

skinparam interface {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

skinparam PackageBorderColor white
skinparam PackageStyle Rectangle
skinparam PackageFontColor white

title C4 Level 4 — Code\nZoom: GitHubAdapter

' contratto che il dominio usa per parlare con Github
package "Application Layer" {
    interface IGithubClientPort <<Outbound Port>> {
        + {abstract} validateAndGetProfile(pat: string): Promise<GithubProfileDTO>
    }
}

' dato che il dominio riceve dopo la validazione del PAT
package "DTOs" {
    class "ValueObject: GithubProfileDTO" as GithubProfileDTO <<Value Object>> {
        + githubId: string
        + email: string
    }
}

package "Mappers" {
    interface "IMapper: IGithubProfileMapper" as IGithubProfileMapper {
        + {abstract} toDTO(response: GitHubAPIResponse): GithubProfileDTO
    }

    ' traduce la risposta di Github nel DTO di dominio
    class "ConcreteMapper: GithubProfileMapper" as GithubProfileMapper {
        + toDTO(response: GitHubAPIResponse): GithubProfileDTO
    }

    class "RawType: GitHubAPIResponse" as GitHubAPIResponse {
        + id: number
        + email: string
    }

    GithubProfileMapper ..|> IGithubProfileMapper : implements
}

package "Adapter" {
    class GitHubAdapter <<Adapter>> {
        - profileMapper: IGithubProfileMapper

        .. IGithubClientPort ..
        + validateAndGetProfile(pat: string): Promise<GithubProfileDTO>
    }
}

package "External Systems" {
    class "ExternalAPI: GitHub REST API" as GitHubAPI #FAD7A0 {
        + Base URL: https://api.github.com
        + Endpoint: GET /user
        + Header: Authorization: token {pat}
    }
}

GitHubAdapter ..up.|> IGithubClientPort
GitHubAdapter --> IGithubProfileMapper         : uses
GitHubAdapter --right-> GitHubAPI              : "GET /user"

IGithubClientPort ..left.> GithubProfileDTO
IGithubProfileMapper ..up.> GithubProfileDTO
IGithubProfileMapper ..up.> GitHubAPIResponse

@enduml