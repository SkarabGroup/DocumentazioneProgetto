@startuml C4_Level4_Orchestrator_Code
title C4 Level 4 — Orchestrator Agent Class Diagram (Analysis Service)

skinparam linetype ortho
skinparam classAttributeIconSize 0

package "Core Domain" {
    
    interface "IRepoProvider" <<Port>> {
        + fetch_repository(url: String): Path
        + get_file_tree(): List
    }

    interface "IStorageProvider" <<Port>> {
        + save_summary(report: Report): Boolean
        + upload_full_report(json_data: String): String
    }

    interface "ICredentialProvider" <<Port>> {
        + get_auth_token(user_id: String, provider: String): String
    }

    class AnalysisOrchestrator {
        - agents: List<BaseAgent>
        - repo_port: IRepoProvider
        - storage_port: IStorageProvider
        - cred_port: ICredentialProvider
        + run_analysis(request: AnalysisRequest): Report
        - aggregate_results(results: List): Report
    }

    abstract class BaseAgent {
        # llm_client: BedrockClient
        + {abstract} execute(context: Context): AgentResult
    }

    class TestAgent extends BaseAgent
    class OwaspAgent extends BaseAgent
    class DocAgent extends BaseAgent
    class RemediationAgent extends BaseAgent
}

package "Infrastructure Adapters" {
    class GitAdapter implements IRepoProvider {
        - cred_client: CredentialClient
        + fetch_repository(url: String): Path
    }

    class MongoS3Adapter implements IStorageProvider {
        - mongo_client: MongoClient
        - s3_client: Boto3Client
        + save_summary(report: Report)
    }

    class CredentialClient implements ICredentialProvider {
        - api_endpoint: String
        + get_auth_token(user_id: String): String
    }
}

' Relazioni
AnalysisOrchestrator o-- BaseAgent : manages >
AnalysisOrchestrator ..> IRepoProvider : uses >
AnalysisOrchestrator ..> IStorageProvider : uses >
GitAdapter --> CredentialClient : calls >

@enduml