@startuml C4_Scan_Agents

' --- CONFIGURAZIONE ESTETICA ---
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 90
skinparam classAttributeIconSize 0
hide circles
skinparam class {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 12
}
skinparam interface {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}
skinparam package {
    BorderColor #999999
    BackgroundColor White
}

title C4 Level 4 — Code\nZoom: Lambda Scan Agents (Phase 1)

' ============================================================
' 1. APPLICATION LAYER
' ============================================================
package "Application Layer" {

    interface IScanTool <<Port>> {
        + run(repoPath: str): dict
    }

    abstract class ScanAgentBase <<abstract>> {
        # scanTool: IScanTool
        # s3Key: str
        + {abstract} getAgentName(): str
        + execute(zipPath: str): ScanOutput
    }
}

' ============================================================
' 2. DOMAIN LAYER
' ============================================================
package "Domain" {

    class SecurityScanAgent {
        + getAgentName(): str
    }

    class SecretsScanAgent {
        + getAgentName(): str
    }

    class DependencyScanAgent {
        + getAgentName(): str
    }

    class DocumentationScanAgent {
        + getAgentName(): str
    }

    note bottom of DocumentationScanAgent
        Non utilizza IScanTool.
        Usa direttamente ILLMProvider
        (definita in bedrock_agents.plantuml)
        per analisi documentazione LLM-driven.
    end note

    class OpenAPIScanAgent {
        + getAgentName(): str
    }
}

' ============================================================
' 3. INFRASTRUCTURE LAYER
' ============================================================
package "Infrastructure" {

    class SemgrepAdapter {
        - ruleset: str
        + run(repoPath: str): dict
    }

    note right of SemgrepAdapter
        ruleset: owasp-top-ten / p/security-audit
    end note

    class TrivyAdapter {
        + run(repoPath: str): dict
    }

    note right of TrivyAdapter
        Secrets scan.
        Output: tipo / file / riga
    end note

    class GrypeAdapter {
        - syft: SyftAdapter
        + run(repoPath: str): dict
    }

    class SyftAdapter {
        + generateSBOM(repoPath: str): dict
    }

    class SpectralAdapter {
        + run(repoPath: str): dict
    }

    note right of SpectralAdapter
        Linting OAS3.
        Output: rule / severity / path
    end note

    class S3OutputClient {
        + putObject(key: str, body: dict)
    }
}

' ============================================================
' RELAZIONI — INHERITANCE (cross-package)
' ============================================================
SecurityScanAgent    --|> ScanAgentBase
SecretsScanAgent     --|> ScanAgentBase
DependencyScanAgent  --|> ScanAgentBase
DocumentationScanAgent --|> ScanAgentBase
OpenAPIScanAgent     --|> ScanAgentBase

' ============================================================
' RELAZIONI — IMPLEMENTS / USES
' ============================================================
SemgrepAdapter  ..|> IScanTool : implements
TrivyAdapter    ..|> IScanTool : implements
GrypeAdapter    ..|> IScanTool : implements
SpectralAdapter ..|> IScanTool : implements

SecurityScanAgent   --> SemgrepAdapter  : uses
SecretsScanAgent    --> TrivyAdapter    : uses
DependencyScanAgent --> GrypeAdapter    : uses
OpenAPIScanAgent    --> SpectralAdapter : uses

GrypeAdapter --> SyftAdapter : delegates SBOM

ScanAgentBase --> S3OutputClient : saves output

@enduml
