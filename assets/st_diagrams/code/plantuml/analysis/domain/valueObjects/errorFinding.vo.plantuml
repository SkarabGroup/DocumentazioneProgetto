@startuml ErrorFinding

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class ErrorFinding {
    - errorLine: int
    - descriptionFinding: DescriptionFinding
    - severityFinding: SeverityFinding
    ---
    - ErrorFinding(line: int, description: DescriptionFinding, severity: SeverityFinding)
    + getErrorLine() : int
    + getDescriptionFinding() : DescriptionFinding
    + getSeverityFinding() : SeverityFinding
    + {static} create(line: int, description: DescriptionFinding, severity: SeverityFinding) : ErrorFinding
}

ErrorFinding --left--> DescriptionFinding
ErrorFinding --right--> SeverityFinding
@enduml