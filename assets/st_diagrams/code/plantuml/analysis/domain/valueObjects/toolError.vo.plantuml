@startuml ToolError
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class ToolError {
    - _toolName: string
    - _description: DescriptionFinding
    ---
    - ToolError(tool, description)
    + {static} create(tool: string, description: DescriptionFinding): ToolError
    + getToolName(): string
    + getDescriptionFinding(): DescriptionFinding
    + equals(other: ToolError): boolean
}

ToolError --down-> DescriptionFinding
@enduml