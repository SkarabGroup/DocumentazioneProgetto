@startuml PATPassword
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class PATPassword {
    - _value: string
    ---
    - PATPassword(value: string)
    - validate(value: string): void
    + {static} create(value: string): PATPassword
    + get value(): string
}
@enduml