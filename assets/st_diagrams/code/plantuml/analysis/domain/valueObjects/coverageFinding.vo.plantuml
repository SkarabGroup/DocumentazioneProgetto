@startuml CoverageFinding

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class CoverageFinding {
    - _totalLinesPercentage: CoveragePercentage
    - _totalBranchesPercentage: CoveragePercentage
    - _coverageFiles: FileCoverage[]
    - _analyzedLanguage: SupportedLanguages
    ---
    - CoverageFinding(lines, branches, files, language)
    - validate(): void
    + {static} create(lines, branches, files, language): CoverageFinding
    + getTotalLinesPercentage(): CoveragePercentage
    + getTotalBranchesPercentage(): CoveragePercentage
    + getCoverageFiles(): FileCoverage[]
    + getAnalyzedLanguage(): SupportedLanguages
    + equals(other: CoverageFinding): boolean
}

CoverageFinding --right-> CoveragePercentage
CoverageFinding --right-> FileCoverage
CoverageFinding --down-> SupportedLanguages
@enduml