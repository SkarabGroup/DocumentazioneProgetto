@startuml CoverageFinding

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class CoverageFinding {
    - totalLinesPercentage: CoveragePercentage
    - totalBranchesPercentage: CoveragePercentage
    - coverageFiles: CoverageFile[]
    ---
    - CoverageFinding(lines: CoveragePercentage, branches: CoveragePercentage, filesCov: CoverageFile[])
    + getTotalLinesPercentage() : CoveragePercentage
    + getTotalBranchesPercentage() : CoveragePercentage
    + getCoverageFiles() : CoverageFile[]
    + {static} create(lines: CoveragePercentage, branches: CoveragePercentage, filesCov: CoverageFile[]) : CoverageFinding
}

CoverageFinding --left--> CoverageFile
CoverageFinding --right--> CoveragePercentage
@enduml