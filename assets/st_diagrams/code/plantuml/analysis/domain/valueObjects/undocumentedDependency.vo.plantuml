@startuml UndocumentedDependency
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class UndocumentedDependency {
    - _name: string
    - _pathFinding: PathFinding
    ---
    - UndocumentedDependency(name, pathFinding)
    + {static} create(name: string, path: PathFinding): UndocumentedDependency
    + getName(): string
    + getPathFinding(): PathFinding
    + equals(other: UndocumentedDependency): boolean
}

UndocumentedDependency --right-> PathFinding
@enduml