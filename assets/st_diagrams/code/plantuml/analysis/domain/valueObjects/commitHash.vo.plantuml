@startuml CommitHash

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class CommitHash {
    - _value: string
    ---
    - CommitHash(value: string)
    - validate(value: string): void
    + equals(other: CommitHash): boolean
    + getValue(): string
    + {static} create(value: string): CommitHash
}

@enduml