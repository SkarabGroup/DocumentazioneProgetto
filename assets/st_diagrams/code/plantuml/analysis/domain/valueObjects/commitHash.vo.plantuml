@startuml CommitHash
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class CommitHash {
    - _value: string
    ---
    - CommitHash(value: string)
    - validate(value: string): void
    + {static} create(value: string): CommitHash
    + get value(): string
    + equals(other: CommitHash): boolean
}
@enduml