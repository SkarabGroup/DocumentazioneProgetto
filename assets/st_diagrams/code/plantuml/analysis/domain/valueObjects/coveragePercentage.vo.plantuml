@startuml CoveragePercentage

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class CoveragePercentage {
    - coveragePercentage: float
    ---
    - CoveragePercentage(coverage: float)
    + getCoveragePercentage() : float
    + {static} create(coverage: float) : CoveragePercentage
}

@enduml