@startuml StaticAnalysisFinding

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class StaticAnalysisFinding {
    - pathFinding: PathFinding
    - errorCategory: string
    - errorFinding: ErrorFinding
    - analyzedLanguage: string
    ---
    - StaticAnalysisFinding(path: PathFinding, category: string, error: ErrorFinding, language: string)
    + getPathFinding() : PathFinding
    + getErrorCategory() : string
    + getErrorFinding() : ErrorFinding
    + getAnalyzedLanguage() : string
    + {static} create(path: PathFinding, category: string, error: ErrorFinding, language: string) : StaticAnalysisFinding
}

StaticAnalysisFinding --left--> PathFinding
StaticAnalysisFinding --right--> ErrorFinding
@enduml