@startuml GitHubAnalysisFactoryCommand

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class GitHubAnalysisFactoryCommand {
    + repoURL: string 
    + branch: string 
    + commit: string | null
    + GitHubAnalysisFactoryCommand(id: string, type: AnalysisType = 'GITHUB', url: string, branch: string, commit?: string)
}

GitHubAnalysisFactoryCommand --up|> AnalysisFactoryCommand
@enduml