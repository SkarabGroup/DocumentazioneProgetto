@startuml StartAnalysisCommand
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class StartAnalysisCommand {
    + user: string
    + url: string
    + password?: string
    + branch?: string
    + commit?: string
    + code: boolean
    + docs: boolean
    + security: boolean
    ---
    + StartAnalysisCommand(data)
}
@enduml