@startuml AddRepositoryCollectionService
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

interface AddRepositoryCollectionUseCase {
    + execute(command: AddRepositoryCollectionCommand): Promise<AddRepositoryCollectionResult>
}

class AddRepositoryCollectionService {
    - duplicateChecker: ICollectionExistenceChecker
    - collectionAdder: ICollectionAdderPort
    ---
    + AddRepositoryCollectionService(duplicateChecker, collectionAdder)
    + execute(command: AddRepositoryCollectionCommand): Promise<AddRepositoryCollectionResult>
}

AddRepositoryCollectionService ..|> AddRepositoryCollectionUseCase
AddRepositoryCollectionService --right-> ICollectionExistenceChecker
AddRepositoryCollectionService --left-> ICollectionAdderPort
@enduml