@startuml IRepositoryAuthorizer
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class IRepositoryAuthorizer <<Interface>> {
    + authorize(url: RepoURL, password?: PATPassword): Promise<PersonalAccessToken>
}

IRepositoryAuthorizer --down-> RepoURL
IRepositoryAuthorizer --down-> PATPassword
IRepositoryAuthorizer --down-> PersonalAccessToken
@enduml