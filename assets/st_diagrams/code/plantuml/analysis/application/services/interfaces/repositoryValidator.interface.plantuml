@startuml IRepositoryValidator
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

interface IRepositoryValidator {
    + check(url: RepoURL, pat: PersonalAccessToken | null, branch: BranchName | null, commit: CommitHash | null): Promise<{branch: BranchName, commit: CommitHash}>
}

IRepositoryValidator --right-> RepoURL
IRepositoryValidator --right-> PersonalAccessToken
IRepositoryValidator --down-> BranchName
IRepositoryValidator --down-> CommitHash
@enduml