@startuml GitValidatorService
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

interface IRepositoryValidator {
    + check(url, pat, branch, commit): Promise<{branch, commit}>
}

class GitValidatorService {
    - availabilityPort: IGitHubAvailabilityPort
    ---
    + GitValidatorService(availabilityPort)
    + check(url: RepoURL, pat: PersonalAccessToken | null, branch: BranchName | null, commit: CommitHash | null): Promise<{branch: BranchName, commit: CommitHash}>
}

GitValidatorService ..|> IRepositoryValidator
GitValidatorService --right-> IGitHubAvailabilityPort
@enduml