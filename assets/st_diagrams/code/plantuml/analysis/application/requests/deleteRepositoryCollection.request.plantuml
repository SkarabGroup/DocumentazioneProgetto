@startuml DeleteRepositoryCollectionRequest
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class DeleteRepositoryCollectionRequest {
    + user: UserId
    + url: RepoURL
    ---
    + DeleteRepositoryCollectionRequest(user, url)
}

DeleteRepositoryCollectionRequest --right-> UserId
DeleteRepositoryCollectionRequest --right-> RepoURL
@enduml