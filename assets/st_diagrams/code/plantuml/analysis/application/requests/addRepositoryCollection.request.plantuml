@startuml AddRepositoryCollectionRequest
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class AddRepositoryCollectionRequest {
    + user: UserId
    + url: RepoURL
    + name: string
    + description: string | null
    ---
    + AddRepositoryCollectionRequest(user, url, name, description)
}

AddRepositoryCollectionRequest --right-> UserId
AddRepositoryCollectionRequest --right-> RepoURL
@enduml