@startuml AddReportsToAnalysisRequest
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class AddReportsToAnalysisRequest {
    + analysisId: string
    + codeReportId: string | null
    + documentationReportId: string | null
    + securityReportId: string | null
    ---
    + AddReportsToAnalysisRequest(analysisId, codeReportId, documentationReportId, securityReportId)
}
@enduml