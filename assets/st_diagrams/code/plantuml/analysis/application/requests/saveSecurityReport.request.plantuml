@startuml SaveSecurityReportRequest
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class SaveSecurityReportRequest {
    + reportId: ReportId
    + analysisId: AnalysisId
    + dependencyFindings: DependencyFinding[]
    + owaspFindings: OWASPFinding[]
    + secretFindings: SecretFinding[]
    + toolErrors: ToolError[]
    ---
    + SaveSecurityReportRequest(reportId, analysisId, dependencyFindings, owaspFindings, secretFindings, toolErrors)
}

SaveSecurityReportRequest --down-> ReportId
SaveSecurityReportRequest --down-> AnalysisId
SaveSecurityReportRequest --down-> DependencyFinding
SaveSecurityReportRequest --down-> OWASPFinding
SaveSecurityReportRequest --down-> SecretFinding
SaveSecurityReportRequest --down-> ToolError
@enduml