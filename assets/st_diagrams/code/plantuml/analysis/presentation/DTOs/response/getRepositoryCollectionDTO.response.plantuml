@startuml GetRepositoryCollectionResponseDTO
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50
skinparam ClassAttributeIconSize 0
hide circles

class GetRepositoryCollectionResponseDTO {
    + success: boolean
    + message?: string
    + data?: \{ url: string; name: string; description: string | null; analyses: string[] \}
    ---
    + GetRepositoryCollectionResponseDTO(success, message?, data?)
