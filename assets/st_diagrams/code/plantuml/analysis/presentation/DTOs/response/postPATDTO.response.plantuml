@startuml PostPatResponseDTO
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50
skinparam ClassAttributeIconSize 0
hide circles

class PostPatResponseDTO {
    + added: boolean
    + error?: string
    ---
    - PostPatResponseDTO(added, error?)
    + {static} success(): PostPatResponseDTO
    + {static} failure(error: string): PostPatResponseDTO
}

@enduml