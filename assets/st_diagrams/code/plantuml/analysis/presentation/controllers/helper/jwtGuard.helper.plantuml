@startuml JwtHelper
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50
skinparam ClassAttributeIconSize 0
hide circles

class JwtPayload {
    + sub: string
    + email: string
    + iat?: number
    + exp?: number
}

interface RequestWithUser {
    + user: \{ userId: string; email: string \}
}

class JwtStrategy {
    ---
    + JwtStrategy(config: ConfigurationService)
    + validate(payload: JwtPayload): Promise<\{ userId: string; email: string \}>
}

class JwtAuthGuard {
    ---
}

class UserId <<decorator>>

class AuthGuard {
    ---
}

JwtStrategy ..> JwtPayload
JwtStrategy ..> ConfigurationService
AuthGuard <|-- JwtAuthGuard
JwtAuthGuard ..> JwtStrategy
UserId ..> RequestWithUser

@enduml
