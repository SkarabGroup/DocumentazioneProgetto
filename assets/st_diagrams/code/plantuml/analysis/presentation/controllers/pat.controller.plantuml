@startuml PatController
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class PatController {
    - newPatService: NewPatUseCase
    - deletePatService: DeletePatUseCase
    - updatePatService: UpdatePatUseCase
    ---
    + PatController(newPat, deletePat, updatePat)
    + addNewPat(dto: PostPatRequestDTO): Promise<PostPatResponseDTO>
    + deletePat(dto: DeletePatRequestDTO): Promise<DeletePatResponseDTO>
    + updatePat(dto: UpdatePatRequestDTO): Promise<UpdatePatResponseDTO>
}

PatController --right-> NewPatUseCase
PatController --right-> DeletePatUseCase
PatController --right-> UpdatePatUseCase
@enduml