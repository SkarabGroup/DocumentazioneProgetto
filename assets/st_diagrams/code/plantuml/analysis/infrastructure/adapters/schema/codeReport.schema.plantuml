@startuml CodeReportModel
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class CodeReport <<Mongoose Schema>> {
    - reportId: string
    - analysisId: string
    - metadata: CodeAgentMetadata
    - interpretation: AIInterpretation
    - createdAt: Date
    - updatedAt: Date
}
@enduml