@startuml DocumentationReportModel
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

class DocumentationReport <<Mongoose Schema>> {
    - reportId: string
    - analysisId: string
    - apiViolations: APIViolation[]
    - docsDiscrepancies: DocsDiscrepancy[]
    - missingFiles: MissingFile[]
    - dependencyAudit: DependencyAudit | null
}
@enduml