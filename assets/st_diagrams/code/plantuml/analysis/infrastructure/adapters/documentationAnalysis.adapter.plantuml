@startuml DocumentationAnalysisAdapter
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 30
skinparam ClassAttributeIconSize 0
hide circles

interface IDocumentationAgentPort <<Interface>> {
    + runAnalysis(model: AgentRequest): Promise<DocsAgentResponse>
}

class DocumentationAnalysisAdapter {
    ---
    + runAnalysis(model: AgentRequest): Promise<DocsAgentResponse>
    - runContainer(dockerArgs: string[]): Promise<string>
    - extractJson(raw: string): Record<string, unknown>
    - createFallbackResponse(repository: string): DocsAgentResponse
}

DocumentationAnalysisAdapter ..up-|> IDocumentationAgentPort
@enduml