@startuml OrchestratorReachableClasses
skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep 5
skinparam ranksep 50
skinparam ClassAttributeIconSize 0
hide circles

class DocumentationAnalysisAdapter
class LocalCodeAnalysisAdapter
class LocalSecurityAnalysisAdapter
class ECSDocumentationAnalysisAdapter
class ECSCodeAnalysisAdapter
class ECSSecurityAnalysisAdapter
interface IDocsReportSavePort
interface ICodeReportSavePort
interface ISecurityReportSavePort
interface IUpdateAnalysisPort

interface IDocumentationAgentPort
interface ICodeAgentPort
interface ISecurityAgentPort
class AnalysisOrchestratorService


AnalysisOrchestratorService ..up.|> IAnalysisOrchestrator
AnalysisOrchestratorService --> IDocumentationAgentPort
AnalysisOrchestratorService --> ICodeAgentPort
AnalysisOrchestratorService --> ISecurityAgentPort
AnalysisOrchestratorService --> IDocsReportSavePort
AnalysisOrchestratorService --> ICodeReportSavePort
AnalysisOrchestratorService --> ISecurityReportSavePort
AnalysisOrchestratorService --> IUpdateAnalysisPort
MongoDBAdapter ..up.|> IDocsReportSavePort
MongoDBAdapter ..up.|> ICodeReportSavePort
MongoDBAdapter ..up.|> ISecurityReportSavePort
MongoDBAdapter ..up.|> IUpdateAnalysisPort
DocumentationAnalysisAdapter ..up.|> IDocumentationAgentPort
LocalCodeAnalysisAdapter ..up.|> ICodeAgentPort
LocalSecurityAnalysisAdapter ..up.|> ISecurityAgentPort
ECSDocumentationAnalysisAdapter ..up.|> IDocumentationAgentPort
ECSCodeAnalysisAdapter  ..up.|> ICodeAgentPort
ECSSecurityAnalysisAdapter  ..up.|> ISecurityAgentPort

MongoDBAdapter  ..[hidden]down.> ISecurityAgentPort
MongoDBAdapter  ..[hidden]down.> ICodeAgentPort
