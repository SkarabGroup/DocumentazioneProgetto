@startuml RegistrationController

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class RegistrationController {
    - registrationUseCase: IregistrationUseCase
    ---
    + RegistrationController(registrationUseCase: IregistrationUseCase)
    + register(requestDto: RegistrationDto): Promise<AuthResponseDto>
}

' Relations
RegistrationController --> IregistrationUseCase
RegistrationController ..> RegistrationDto
RegistrationController ..> AuthResponseDto

@enduml
