@startuml DeleteUserController

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class IDeleteUseCase <<Interface>>

class DeleteUserController {
    - deleteUseCase: IDeleteUseCase
    - jwtAdapter: JwtAdapter
    ---
    + DeleteUserController(deleteUseCase: IDeleteUseCase, jwtAdapter: JwtAdapter)
    + delete(req: Request): Promise<DeleteResponseDto>
}

' Relations
DeleteUserController --> IDeleteUseCase
DeleteUserController --> JwtAdapter
DeleteUserController ..> DeleteResponseDto

@enduml
