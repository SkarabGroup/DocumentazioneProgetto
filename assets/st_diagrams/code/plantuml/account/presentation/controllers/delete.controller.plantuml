@startuml DeleteUserController

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class DeleteUserController {
    - deleteUseCase: IDeleteUseCase
    - jwtService: JwtService
    ---
    + DeleteUserController(deleteUseCase: IDeleteUseCase, jwtService: JwtService)
    + delete(req: Request): Promise<DeleteResponseDto>
}

' Relations
DeleteUserController --> IDeleteUseCase
DeleteUserController --> JwtService
DeleteUserController ..> DeleteResponseDto

@enduml
