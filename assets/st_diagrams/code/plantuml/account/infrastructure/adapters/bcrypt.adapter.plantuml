@startuml BcryptAdapter

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class BcryptAdapter {
    - rounds: number
    ---
    + BcryptAdapter(rounds: number)
    + hash(plaintext: string): Promise<string>
    + compare(plaintext: string, hash: string): Promise<boolean>
}

' Relations
BcryptAdapter ..up|> IHashPasswordPort
BcryptAdapter ..up|> IHashComparePort

@enduml
