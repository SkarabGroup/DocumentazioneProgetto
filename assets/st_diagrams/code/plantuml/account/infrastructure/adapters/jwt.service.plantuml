@startuml JwtService

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class JwtService {
    - secret: string
    - expiresIn: string
    ---
    + JwtService(secret: string, expiresIn: string)
    + generateToken(payload: JwtPayload): string
    + generateRefreshToken(payload: JwtPayload): string
    + verifyToken(token: string): JwtPayload | null
}

' Relations
JwtService ..up|> ITokenProviderPort
JwtService ..up|> IVerifyTokenPort
JwtService ..> JwtPayload

@enduml
