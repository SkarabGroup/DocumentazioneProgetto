@startuml User

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class User {
    - _userId: UserId
    - _email: Email
    - _passwordHash: PasswordHash
    - _createdAt: Date
    - _updatedAt: Date
    ---
    - User(userId: UserId, email: Email, passwordHash: PasswordHash, createdAt: Date, updatedAt: Date)
    + {static} create(id: UserId, email: Email, passwordHash: PasswordHash): User
    + {static} reconstitute(userId: UserId, email: Email, passwordHash: PasswordHash, createdAt: Date, updatedAt: Date): User
    + updatePassword(newPasswordHash: PasswordHash): void
    + getUserId(): UserId
    + getEmail(): Email
    + getPasswordHash(): PasswordHash
    + getCreatedAt(): Date
    + getUpdatedAt(): Date
    + equals(other: User): boolean
    + toDTO(): UserDTO
}

' Relations
User --> UserId
User --> Email
User --> PasswordHash
User ..> UserDTO

@enduml
