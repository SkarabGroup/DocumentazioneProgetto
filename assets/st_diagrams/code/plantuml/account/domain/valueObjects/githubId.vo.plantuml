@startuml GithubId

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class GithubId {
    - _value: string
    ---
    - GithubId(value: string)
    + {static} create(value: string): GithubId
    - validate(value: string): void
    + equals(other: GithubId): boolean
    + get value(): string
}

@enduml
