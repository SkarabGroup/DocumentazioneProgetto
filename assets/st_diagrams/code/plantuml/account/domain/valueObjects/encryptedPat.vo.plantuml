@startuml EncryptedPat

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class EncryptedPat {
    - _value: string
    ---
    - EncryptedPat(value: string)
    + {static} create(value: string): EncryptedPat
    - validate(value: string): void
    + equals(other: EncryptedPat): boolean
    + get value(): string
}

@enduml
