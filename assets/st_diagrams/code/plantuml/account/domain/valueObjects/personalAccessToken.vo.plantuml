@startuml PersonalAccessToken

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class PersonalAccessToken {
    - _value: string
    ---
    - PersonalAccessToken(value: string)
    + {static} create(value: string): PersonalAccessToken
    - validate(token: string): void
    + equals(other: PersonalAccessToken): boolean
    + get value(): string
}

@enduml
