@startuml UserIdAccount

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class UserId {
    - _value: string
    ---
    - UserId(value: string)
    + {static} create(value: string): UserId
    + {static} generate(value: string): UserId
    - validate(value: string): void
    + equals(other: UserId): boolean
    + get value(): string
}

@enduml
