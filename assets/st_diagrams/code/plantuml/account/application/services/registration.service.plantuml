@startuml RegistrationService

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class IregistrationUseCase <<Interface>> 
class IUserFindPort <<Interface>> 
class IUserSavePort <<Interface>> 
class IHashPasswordPort <<Interface>> 
class ITokenProviderPort <<Interface>> 

class RegistrationService {
    - userFindPort: IUserFindPort
    - userSavePort: IUserSavePort
    - hashPasswordPort: IHashPasswordPort
    - tokenProviderPort: ITokenProviderPort
    ---
    + RegistrationService(userFindPort: IUserFindPort, userSavePort: IUserSavePort, hashPasswordPort: IHashPasswordPort, tokenProviderPort: ITokenProviderPort)
    + execute(command: RegistrationUserCommand): Promise<AuthResultDto>
}

' Relations
RegistrationService ..up|> IregistrationUseCase
RegistrationService --> IUserFindPort
RegistrationService --> IUserSavePort
RegistrationService --> IHashPasswordPort
RegistrationService --> ITokenProviderPort
RegistrationService ..> RegistrationUserCommand
RegistrationService ..> AuthResultDto

@enduml
