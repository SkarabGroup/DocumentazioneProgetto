@startuml DeleteService

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class IDeleteUseCase <<Interface>> 
class IUserDeletePort <<Interface>> 

class DeleteService {
    - deletePort: IUserDeletePort
    ---
    + DeleteService(deletePort: IUserDeletePort)
    + execute(command: DeleteCommand): Promise<DeleteResponseDto>
}

' Relations
DeleteService ..up|> IDeleteUseCase 
DeleteService --> IUserDeletePort
DeleteService ..> DeleteCommand
DeleteService ..> DeleteResponseDto

@enduml
