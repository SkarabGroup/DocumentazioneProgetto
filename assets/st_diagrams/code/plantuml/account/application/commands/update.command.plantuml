@startuml UpdateUserCommand

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class UpdateUserCommand {
    + email: string
    + newPassword: string
    ---
    + UpdateUserCommand(email: string, newPassword: string)
}

@enduml
