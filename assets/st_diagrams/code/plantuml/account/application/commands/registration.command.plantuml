@startuml RegistrationUserCommand

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles

class RegistrationUserCommand {
    + email: string
    + password: string
    ---
    + RegistrationUserCommand(email: string, password: string)
}

@enduml
