@startuml

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles
skinparam direction top to bottom

package "View — Layout" {
  class AppLayout {
    --
    Wrapper delle route protette. Compone la Sidebar con l'area
    contenuto principale (React Router Outlet). È inserito dentro
    ProtectedRoute, quindi è sempre renderizzato solo se autenticato.
  }

  class Sidebar {
    --
    Barra di navigazione laterale collassabile presente in tutte le
    pagine protette. Mostra logo, link di navigazione (Repository,
    Storico, Classifica, Impostazioni), nome utente e pulsante logout.
  }

  AppLayout *-- "Sidebar"
  AppLayout --> "Outlet (React Router)" : renderizza pagina corrente
  Sidebar --> "useAuth" : user, logout()
}


package "View — Componenti condivisi" {
  class ScoreCard {
    + score: number
    + label: string
    + description?: string
    --
    Visualizza un punteggio numerico (0-100) tramite un gauge SVG
    semicircolare e una barra di progresso lineare. Il colore
    si adatta al valore: verde (>= 80), giallo (>= 50), rosso (< 50).
    Riutilizzato in RepositoryDetailPage e RankingPage.
  }
}
@enduml