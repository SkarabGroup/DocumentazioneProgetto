@startuml

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles
package "View — Pagine pubbliche" {
  class NotFoundPage {
    --
    Pagina 404 mostrata per qualsiasi route non riconosciuta.
    Visualizza un grande "404" e un link per tornare alla home.
  }
}
@enduml
