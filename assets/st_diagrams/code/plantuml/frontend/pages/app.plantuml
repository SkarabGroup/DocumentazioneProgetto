@startuml
package "View — Root" {
  class App {
    --
    Componente radice dell'applicazione. Inizializza BrowserRouter,
    avvolge l'intera app in AuthProvider, e definisce
    la struttura delle route tramite AppRoutes.
    Aggiunge il sistema di notifiche toast (Sonner) in posizione
    bottom-right con tema scuro.
  }

  class ProtectedRoute {
    --
    Guardia per le route autenticate. Se l'utente non è autenticato
    reindirizza a /login. Durante il caricamento mostra uno spinner.
  }

  class PublicRoute {
    --
    Guardia per le route pubbliche (login, register). Se l'utente
    è già autenticato reindirizza a /repositories.
  }

  App *-- ProtectedRoute
  App *-- PublicRoute
  ProtectedRoute --> "useAuth" : controlla isAuthenticated
  PublicRoute --> "useAuth" : controlla isAuthenticated
}
@enduml
