@startuml

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles
package "View — Pagine pubbliche" {
  class LandingPage {
    --
    Pagina di presentazione pubblica del prodotto.
    Mostra hero con CTA, feature showcase, lista degli agenti AI
    usati nell'analisi, sezione pricing e footer.
    Non richiede autenticazione.
  }
}
@enduml
