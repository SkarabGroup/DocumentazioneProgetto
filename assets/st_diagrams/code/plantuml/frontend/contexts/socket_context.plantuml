@startuml

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles
package "Context Layer (ViewModel)" {
  class SocketProvider {
    + socket: Socket | null
    + isConnected: boolean
    --
    Provider React che crea e gestisce la connessione Socket.io
    verso il microservizio Analysis (VITE_ANALYSIS_WS_URL).
    La connessione è autenticata tramite JWT (accessToken).
    Gestisce riconnessione automatica (max 5 tentativi, delay 2s)
    e aggiorna isConnected al variare dello stato della socket.
  }

  SocketProvider --> "TokenStorage" : legge accessToken per auth
}
@enduml
