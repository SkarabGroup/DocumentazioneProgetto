@startuml

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles
package "API Layer (Model)" {
  class PatApi {
    + add(payload): Promise<void>
    + update(payload): Promise<void>
    + delete(payload): Promise<void>
    --
    Gestisce le operazioni di salvataggio, aggiornamento ed eliminazione
    dei Personal Access Token (PAT) per i repository scansionati.
    Comunica con il microservizio Analysis.
  }

  PatApi --> "Gateway" : usa
}
@enduml