@startuml

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles
package "API Layer (Model)" {
  class AuthApi {
    + login(credentials): Promise<AuthTokens & { user: User }>
    + register(credentials): Promise<AuthTokens & { user: User }>
    + refresh(refreshToken): Promise<AuthTokens>
    + logout(): Promise<void>
    --
    Incapsula le chiamate HTTP verso il microservizio Account
    per login, registrazione, refresh token e logout.
    Tutti i metodi delegano al Gateway per l'invio HTTP.
  }

  AuthApi --> "Gateway" : usa
}
@enduml
