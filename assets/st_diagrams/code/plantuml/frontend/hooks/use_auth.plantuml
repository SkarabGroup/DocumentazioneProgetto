@startuml

skinparam componentStyle uml2.5
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0
hide circles
package "Hooks Layer (ViewModel)" {
  class useAuth {
    --
    Custom hook che restituisce il valore corrente di AuthContext.
    Lancia un errore esplicito se usato fuori dall'AuthProvider,
    garantendo che i componenti consumatori siano sempre nel
    contesto corretto.
  }

  useAuth --> "AuthProvider" : consuma AuthContext
}
@enduml
