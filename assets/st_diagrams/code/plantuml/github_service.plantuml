@startuml C4_GitHub_Service

skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 90
skinparam classAttributeIconSize 0
hide circles

skinparam class {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 12
}

skinparam interface {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

skinparam PackageBorderColor white
skinparam PackageStyle Rectangle
skinparam PackageFontColor white

title C4 Level 4 — Code\nZoom: GitHubService

' deve poter essere associato un PAT ad un utente e anche rimosso
package "Inbound Ports" {
    interface IAssociatePatUseCase <<Inbound Port>> {
        + {abstract} associatePat(userId: string, pat: string): Promise<void>
    }
    interface IRemovePatUseCase <<Inbound Port>> {
        + {abstract} removePat(userId: string): Promise<void>
    }
}

package "Domain Entities & DTOs" {
    ' contiene ID e email recuperati da Github
    class "ValueObject: GithubProfileDTO" as GithubProfileDTO <<Value Object>> {
        + githubId: string
        + email: string
    }

    ' salva nel db il token già cifrato
    class GithubToken {
        + userId: string
        + encryptedPat: string
        + githubId: string
    }
}

package "Application Services" {
    class GitHubService <<Facade>> {
        - githubClientPort: IGithubClientPort
        - saveTokenPort: ISaveTokenPort
        - findTokenPort: IFindTokenByUserIdPort
        - deleteTokenPort: IDeleteTokenPort
        - encryptPort: IEncryptTextPort
        - decryptPort: IDecryptTextPort
        - tokenFactory: GithubTokenFactory

        .. IAssociatePatUseCase ..
        + associatePat(userId: string, pat: string): Promise<void>
        .. IRemovePatUseCase ..
        + removePat(userId: string): Promise<void>
    }

    ' crea un oggetto GithubToken criptando il PAT
    class GithubTokenFactory <<Factory Method>> {
        + createToken(userId: string, pat: string, githubId: string, encryptor: IEncryptTextPort): Promise<GithubToken>
    }
}

package "Outbound Ports" {
    ' interroga le API di Github
    interface IGithubClientPort <<Outbound Port>> {
        + {abstract} validateAndGetProfile(pat: string): Promise<GithubProfileDTO>
    }

    ' interagiscono con il db
    interface ISaveTokenPort <<Outbound Port>> {
        + {abstract} saveToken(token: GithubToken): Promise<void>
    }
    
    interface IFindTokenByUserIdPort <<Outbound Port>> {
        + {abstract} findByUserId(userId: string): Promise<GithubToken>
    }
    
    interface IDeleteTokenPort <<Outbound Port>> {
        + {abstract} deleteToken(userId: string): Promise<void>
    }
}

' definiscono i metodi per cifrare e decifrare il PAT 
package "Service Interfaces" {
    interface IEncryptTextPort <<Interface>> {
        + {abstract} encryptText(plainText: string): Promise<string>
    }
    
    interface IDecryptTextPort <<Interface>> {
        + {abstract} decryptText(cipherText: string): Promise<string>
    }
}

GitHubService ..up.|> IAssociatePatUseCase
GitHubService ..up.|> IRemovePatUseCase
GitHubService --> IGithubClientPort          : uses
GitHubService --> ISaveTokenPort             : uses
GitHubService --> IFindTokenByUserIdPort     : uses
GitHubService --> IDeleteTokenPort           : uses
GitHubService --> IEncryptTextPort           : uses
GitHubService --> IDecryptTextPort           : uses
GitHubService --> GithubTokenFactory         : uses

GithubTokenFactory ..> GithubToken : creates
IGithubClientPort ..right.> GithubProfileDTO

@enduml
