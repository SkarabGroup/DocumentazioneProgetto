@startuml C4_MongoDB_Adapter

' --- CONFIGURAZIONE ESTETICA ---
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 90
skinparam classAttributeIconSize 0
hide circles
skinparam class {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 12
}
skinparam interface {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

title C4 Level 4 — Code\nZoom: port_db → mongo_adapter

' --- 1. APPLICATION LAYER (Use Cases & Services) ---

class CacheService #6d6b6b{
    - dbUseCase: IDbUseCase
    +checkCache(repository: string, commitSha: string): Promise<DTO>
}
interface iDbUseCase  {
    + {abstract} save(dto: DTO): void
    + {abstract}findUserReports(userId: string): Promise<List<DTO>>
    + {abstract}findReport(repository: string, commitSha: string): Promise<DTO>
}

class DbService {
    - dbPort: IPortDb
    +save(dto: DTO): void
    +findUserReports(userId: string): Promise<List<DTO>>
    +findReport(repository: string, commitSha: string): Promise<DTO>
}

' --- 2. DOMAIN LAYER (Abstract & Concrete Products) ---
abstract class "AbstractProduct: DTO" as DTO {
    + id:string
    + repository: string
    + commitSha: string
    + userId: string
    + timestamp: Date
}
class "ConcreteProduct: DTOOWASP" as DTOOWASP extends DTO
class "ConcreteProduct: DTOCode" as DTOCode   extends DTO
class "ConcreteProduct: DTOTest" as DTOTest   extends DTO

' --- 3. INFRASTRUCTURE LAYER - MAPPING (Factory Method Creators) ---
abstract class "AbstractCreator: ReportMapper" as ReportMapper {
    {abstract} +toDTO(doc: DbSchema): DTO
    {abstract} +toPersistence(dto: DTO): DbSchema
}

class "ConcreteCreator: OwaspMapper" as OwaspMapper extends ReportMapper {
    +toDTO(doc: DbSchemaOWASP): DTOOWASP
    +toPersistence(dto: DTOOWASP): DbSchemaOWASP
}

class "ConcreteCreator: CodeMapper" as CodeMapper extends ReportMapper {
    +toDTO(doc: DbSchemaCode): DTOCode
    +toPersistence(dto: DTOCode): DbSchemaCode
}

class "ConcreteCreator: TestMapper" as TestMapper extends ReportMapper {
    +toDTO(doc: DbSchemaTest): DTOTest
    +toPersistence(dto: DTOTest): DbSchemaTest
}

' --- 4. INFRASTRUCTURE LAYER - PERSISTENCE (Adapter & Schemas) ---
interface IPortDb {
    +  {abstract}save(dto: DTO): void
    + {abstract}findUserReports(userId: string): Promise<List<DTO>>
    + {abstract}findReport(repository: string, commitSha: string): Promise<DTO>
}

class MongoDbAdapter {
    - owaspDbModel: Model<DbSchemaOWASP>
    - codeDbModel: Model<DbSchemaCode>
    - testDbModel: Model<DbSchemaTest>
    - mapper: ReportMapper
    + save(dto: DTO): void
    + findUserReports(userId: string): Promise<List<DTO>>
    + findReport(repository: string, commitSha: string): Promise<DTO>
}

MongoDbAdapter --right-> DbSchemaOWASP
MongoDbAdapter --right-> DbSchemaCode
MongoDbAdapter --right-> DbSchemaTest

note left of MongoDbAdapter::codeDbModel
    import { Model } from 'mongoose'
end note

note left of MongoDbAdapter::mapper
    ho un dizionario con le chiavi che identificano il tipo di report (es. "OWASP", "CODE", "TEST") 
    e setto il mapper tramite il costruttore del tipo corretto(OwaspMapper, CodeMapper, TestMapper)
    quando leggo il tipo di DTO/schema.
end note

abstract class DbSchema {
    + id:string
    + repository: string
    + commitSha: string
    + userId: string
    + timestamp: Date
}
class DbSchemaOWASP extends DbSchema
class DbSchemaCode extends DbSchema
class DbSchemaTest extends DbSchema

' --- 5. RELAZIONI DI DIPENDENZA (WIRING) ---
CacheService --> iDbUseCase : uses (findReport)
DbService ..up.|> iDbUseCase : implements
DbService --down-> IPortDb : uses
MongoDbAdapter ..up.|> IPortDb : implements
MongoDbAdapter --> ReportMapper
ReportMapper ..left.> DTO 
ReportMapper ..right.> DbSchema

@enduml