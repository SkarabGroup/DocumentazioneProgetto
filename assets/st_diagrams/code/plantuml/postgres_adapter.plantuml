@startuml C4_Postgres_Account_Adapter

skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 90
skinparam classAttributeIconSize 0
hide circles

skinparam class {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 12
}

skinparam interface {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

skinparam PackageBorderColor white
skinparam PackageStyle Rectangle
skinparam PackageFontColor white

title C4 Level 4 — Code\nZoom: PostgresAccountAdapter

package "Application Layer" {

    ' User Ports
    interface IFindUserByUsernamePort <<Outbound Port>> {
        + {abstract} findByUsername(username: string): Promise<UserDTO>
    }
    interface IFindUserByEmailPort <<Outbound Port>> {
        + {abstract} findByEmail(email: string): Promise<UserDTO>
    }
    interface IFindUserByIdPort <<Outbound Port>> {
        + {abstract} findById(id: string): Promise<UserDTO>
    }
    interface ISaveUserPort <<Outbound Port>> {
        + {abstract} saveUser(user: UserDTO): Promise<void>
    }
    interface IDeleteUserPort <<Outbound Port>> {
        + {abstract} deleteUser(userId: string): Promise<void>
    }

    ' Token Ports
    interface ISaveTokenPort <<Outbound Port>> {
        + {abstract} saveToken(token: GithubToken): Promise<void>
    }
    interface IFindTokenByUserIdPort <<Outbound Port>> {
        + {abstract} findByUserId(userId: string): Promise<GithubToken>
    }
    interface IDeleteTokenPort <<Outbound Port>> {
        + {abstract} deleteToken(userId: string): Promise<void>
    }
}

package "DTOs" {
    abstract class "AbstractDTO: AccountDTO" as AccountDTO {
        + id: string
        + createdAt: Date
    }

    class "ConcreteDTO: UserDTO" as UserDTO extends AccountDTO {
        + username: string
        + email: string
        + passwordHash: string
        + passwordSalt: string
    }

    class "DomainEntity: GithubToken" as GithubToken <<Entity>> {
        + userId: string
        + encryptedPat: string
        + githubId: string
    }
}

package "Mappers" {
    abstract class "AbstractMapper: AccountMapper<S,D>" as AccountMapper {
        {abstract} +toDTO(schema: S): D
        {abstract} +toPersistence(dto: D): S
    }

    class "ConcreteMapper: UserMapper" as UserMapper extends AccountMapper {
        +toDTO(schema: UserTable): UserDTO
        +toPersistence(dto: UserDTO): UserTable
    }

    class "ConcreteMapper: GithubTokenMapper" as GithubTokenMapper extends AccountMapper {
        +toDTO(schema: GithubTokenTable): GithubToken
        +toPersistence(dto: GithubToken): GithubTokenTable
    }
}

package "Adapter" {
    class PostgresAccountAdapter <<Adapter>> {
        - userRepo: Repository<UserTable>
        - tokenRepo: Repository<GithubTokenTable>
        - userMapper: UserMapper
        - tokenMapper: GithubTokenMapper

        .. User Ports ..
        + findByUsername(username: string): Promise<UserDTO>
        + findByEmail(email: string): Promise<UserDTO>
        + findById(id: string): Promise<UserDTO>
        + saveUser(user: UserDTO): Promise<void>
        + deleteUser(userId: string): Promise<void>

        .. Token Ports ..
        + saveToken(token: GithubToken): Promise<void>
        + findByUserId(userId: string): Promise<GithubToken>
        + deleteToken(userId: string): Promise<void>
    }
}

package "Persistence" {
    abstract class "AbstractTable: DbSchema" as DbSchema <<Entity>> {
        + id: uuid <<PK>>
        + created_at: timestamp
    }

    class "ConcreteTable: UserTable" as UserTable <<Entity>> #FAD7A0 extends DbSchema {
        + username: varchar(20) <<Unique, NotNull>>
        + email: varchar(254) <<Unique, NotNull>>
        + password_hash: varchar(255) <<NotNull>>
        + password_salt: varchar(255) <<NotNull>>
    }

    class "ConcreteTable: GithubTokenTable" as GithubTokenTable <<Entity>> #FAD7A0 extends DbSchema {
        + user_id: uuid <<FK → UserTable.id, NotNull>>
        + encrypted_pat: text <<NotNull>>
        + github_user_id: varchar(50) <<NotNull>>
    }
}

PostgresAccountAdapter ..up.|> IFindUserByUsernamePort
PostgresAccountAdapter ..up.|> IFindUserByEmailPort
PostgresAccountAdapter ..up.|> IFindUserByIdPort
PostgresAccountAdapter ..up.|> ISaveUserPort
PostgresAccountAdapter ..up.|> IDeleteUserPort
PostgresAccountAdapter ..up.|> ISaveTokenPort
PostgresAccountAdapter ..up.|> IFindTokenByUserIdPort
PostgresAccountAdapter ..up.|> IDeleteTokenPort

PostgresAccountAdapter --> UserMapper         : uses
PostgresAccountAdapter --> GithubTokenMapper  : uses
PostgresAccountAdapter --right-> UserTable
PostgresAccountAdapter --right-> GithubTokenTable

UserMapper ..left.>  UserDTO
UserMapper ..right.> UserTable
GithubTokenMapper ..left.>  GithubToken
GithubTokenMapper ..right.> GithubTokenTable

@enduml