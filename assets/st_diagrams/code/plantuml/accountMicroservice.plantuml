@startuml login_unified
skinparam linetype ortho
skinparam nodesep auto
skinparam ranksep 70
skinparam ClassAttributeIconSize 0

skinparam PackageBorderColor white
skinparam PackageStyle Rectangle
skinparam PackageFontColor white
hide circles

title Diagramma Integrale - CodeGuardian Account Microservice

skinparam class {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 11
}

skinparam package {
    BorderColor white
    Style Rectangle
    PackageFontColor white
}

skinparam interface {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}

' PRIMARY ADAPTERS (Entry Points)
package PrimaryAdapters {

    class LoginController {
        - loginUseCase: LoginUseCase
        + login(dto: LoginDto): Promise<AuthResponseDto>
    }

    class RegistrationController {
        - registrationUseCase: RegistrationUseCase
        + register(dto: RegistrationDto): Promise<AuthResponseDto>
    }

    class DeleteUserController {
        - deleteUseCase: DeleteUseCase
        + delete(dto: DeleteDto): Promise<DeleteResponseDto>
    }

    class GitHubController {
        - associatePatUseCase: IAssociatePatUseCase
        - removePatUseCase: IRemovePatUseCase
        + associatePat(dto: AssociatePatDto): Promise<void>
        + removePat(dto: RemovePatDto): Promise<void>
    }

    'DTO 
    class LoginDto <<DTO>> {
        + email: string
        + password: string
    }

    class RegistrationDto <<DTO>> {
        + email: string
        + password: string
    }

    class DeleteDto <<DTO>> {
        + userToDelete: string
    }

    class AssociatePatDto <<DTO>> {
        + userId: string
        + pat: string
    }

    class RemovePatDto <<DTO>> {
        + userId: string
    }

    class AuthResponseDto <<DTO>> {
        + accessToken: string
        + refreshToken: string
        + user: UserDTO
    }

    class DeleteResponseDto <<DTO>> {
        + deleted: boolean
    }
}

' DOMAIN CORE 
package DomainCore {

    package UseCases {
        interface LoginUseCase <<Inbound Port>> {
            + {abstract} execute(dto: LoginDto): Promise<AuthResponseDto>
        }
        interface RegistrationUseCase <<Inbound Port>> {
            + {abstract} execute(dto: RegistrationDto): Promise<AuthResponseDto>
        }
        interface DeleteUseCase <<Inbound Port>> {
            + {abstract} execute(dto: DeleteDto): Promise<DeleteResponseDto>
        }
        interface IAssociatePatUseCase <<Inbound Port>> {
            + {abstract} associatePat(userId: string, pat: string): Promise<void>
        }
        interface IRemovePatUseCase <<Inbound Port>> {
            + {abstract} removePat(userId: string): Promise<void>
        }
    }

    package Ports {

        ' User
        interface IFindUserByEmailPort <<Outbound Port>> {
            + {abstract} findByEmail(email: string): Promise<UserDTO | null>
        }
        interface IUserSaveRepositoryPort <<Outbound Port>> {
            + {abstract} saveUser(user: UserDTO): Promise<void>
        }
        interface IUserDeletePort <<Outbound Port>> {
            + {abstract} deleteUser(userId: string): Promise<void>
        }

        ' GitHub Token (DB)
        interface ISaveTokenPort <<Outbound Port>> {
            + {abstract} saveToken(token: GithubTokenDTO): Promise<void>
        }
        interface IFindTokenByUserIdPort <<Outbound Port>> {
            + {abstract} findByUserId(userId: string): Promise<GithubTokenDTO | null>
        }
        interface IDeleteTokenPort <<Outbound Port>> {
            + {abstract} deleteToken(userId: string): Promise<void>
        }

        ' GitHub REST API
        interface IGithubClientPort <<Outbound Port>> {
            + {abstract} validateAndGetProfile(pat: string): Promise<GithubProfileDTO>
        }

        package ServiceInterfaces {
            ' Crypto
            interface IEncryptTextPort <<Outbound Port>> {
                + {abstract} encryptText(plainText: string): Promise<string>
            }

            ' Infrastruttura
            ' LoginService usa solo IComparePort
            ' RegistrationService usa solo IHashPort
            interface IHashPort <<Interface>> {
                + {abstract} hash(plaintext: string): Promise<string>
            }
            interface IComparePort <<Interface>> {
                + {abstract} compare(plaintext: string, hash: string): Promise<boolean>
            }

            ' da valutare separazione metodi Jwt
            interface Jwt <<Interface>> {
                + {abstract} generateToken(payload: JwtPayload): string
                + {abstract} verifyToken(token: string): JwtPayload | null
            }
        }
    }

    'Application Logic
    package Application {

        class LoginService {
            - userRepository: IUserRepositoryPort
            - jwt: Jwt
            - bcrypt: Bcrypt
            - checkExistentUser(email: string): Promise<UserDTO>
            - checkPasswordHash(plaintext: string, hash: string): Promise<boolean>
            - generateJWT(user: User): string
            + execute(dto: LoginDto): Promise<AuthResponseDto>
        }

        class RegistrationService {
            - userRepository: IUserRepositoryPort
            - userSave: IUserSaveRepositoryPort
            - jwt: Jwt
            - bcrypt: Bcrypt
            - checkNewUser(email: string): Promise<boolean>
            - buildUserDTO(dto: RegistrationDto, hash: string): UserDTO
            - generateJWT(user: User): string
            + execute(dto: RegistrationDto): Promise<AuthResponseDto>
        }

        class DeleteService {
            - deletePort: IUserDeletePort
            + execute(dto: DeleteDto): Promise<DeleteResponseDto>
        }

        class GitHubService {
            - githubClientPort: IGithubClientPort
            - saveTokenPort: ISaveTokenPort
            - findTokenPort: IFindTokenByUserIdPort
            - deleteTokenPort: IDeleteTokenPort
            - encryptPort: IEncryptTextPort
            - tokenFactory: GithubTokenFactory
            + associatePat(userId: string, pat: string): Promise<void>
            + removePat(userId: string): Promise<void>
        }

        class GithubTokenFactory <<Factory>> {
            + createToken(userId: string, pat: string, githubId: string, encryptor: IEncryptTextPort): Promise<GithubTokenDTO>
        }

        'Domain Entities 
        class User <<Entity>> {
            + id: string
            + email: string
            + passwordHash: string
            + createdAt: Date
            + updatedAt: Date
        }

        class GithubToken <<Entity>> {
            + userId: string
            + githubId: string
            + encryptedPat: string
        }

        'DTOs (Domain <-> Adapter)
        abstract class AccountDTO <<DTO>> {
            + id: string
            + createdAt: Date
        }

        class UserDTO <<DTO>> {
            + email: string
            + passwordHash: string
            + updatedAt: Date
        }

        class GithubTokenDTO <<DTO>> {
            + userId: string
            + githubId: string
            + encryptedPat: string
        }
    }
}

' SECONDARY ADAPTERS 
package SecondaryAdapters {

    package PostgresAdapter {

        ' implicito RDS
        class PostgresAccountAdapter <<Adapter>> {
            - userRepo: Repository<UserTable>
            - tokenRepo: Repository<GithubTokenTable>
            - userMapper: UserMapper
            - tokenMapper: GithubTokenMapper
            .. User Ports ..
            + findByEmail(email: string): Promise<UserDTO | null>
            + saveUser(user: UserDTO): Promise<void>
            + deleteUser(userId: string): Promise<void>
            .. Token Ports ..
            + saveToken(token: GithubTokenDTO): Promise<void>
            + findByUserId(userId: string): Promise<GithubTokenDTO | null>
            + deleteToken(userId: string): Promise<void>
        }

        abstract class AccountMapper<S, D> {
            + {abstract} toDTO(schema: S): D
            + {abstract} toPersistence(dto: D): S
        }

        class UserMapper {
            + toDTO(schema: UserTable): UserDTO
            + toPersistence(dto: UserDTO): UserTable
        }

        class GithubTokenMapper {
            + toDTO(schema: GithubTokenTable): GithubTokenDTO
            + toPersistence(dto: GithubTokenDTO): GithubTokenTable
        }

        abstract class DbSchema <<Entity>> {
            + id: uuid <<PK>>
            + created_at: timestamp
        }

        class UserTable <<Entity>> {
            + email: varchar(254) <<Unique, NotNull>>
            + password_hash: varchar(255) <<NotNull>>
            + updated_at: timestamp
        }

        class GithubTokenTable <<Entity>> {
            + user_id: uuid <<FK - UserTable.id, NotNull>>
            + encrypted_pat: text <<NotNull>>
            + github_user_id: varchar(50) <<NotNull>>
        }
    }

    package GitHubAdapterPkg {

        class GitHubAdapter <<Adapter>> {
            - profileMapper: GithubProfileMapper
            + validateAndGetProfile(pat: string): Promise<GithubProfileDTO>
        }

        class GithubProfileMapper {
            + toDTO(response: GitHubAPIResponse): GithubProfileDTO
        }

        class GithubProfileDTO <<DTO>> {
            + githubId: string
            + email: string
        }

        class GitHubAPIResponse <<RawType>> {
            + id: number
            + email: string
        }

        class GitHubAPI <<ExternalSystem>> {
            + Base URL: https://api.github.com
            + Endpoint: GET /user
            + Header: Authorization: token {pat}
        }

        package ConfigInterfaces {
            interface ConfJwt <<Interface>> {
                + {abstract} getJwtSecret(): string
            }
            interface ConfRounds <<Interface>> {
                + {abstract} getBcryptRounds(): number
            }
            interface ConfPostgre <<Interface>> {
                + {abstract} getDBURL(): string
            }
        }
    }

    'Config & Crypto
    class ConfigService {
        - envConfig: Record<string, string>
        - loadFromSSM(): Promise<void>
        + getJwtSecret(): string
        + getBcryptRounds(): number
        + getDBURL(): string
        + validate(): void
    }

    class AWSSSM <<ExternalSystem>> {
        + Service: AWS SSM Parameter Store
        + Secrets: JWT_SECRET, BCRYPT_ROUNDS,\n  DATABASE_URL, TOKEN_ENCRYPTION_KEY
        + Access: App Runner → process.env at boot
    }

    class BcryptService {
        - rounds: number
        + hash(plaintext: string): Promise<string>
        + compare(plaintext: string, hash: string): Promise<boolean>
    }

    class JwtService {
        - secret: string
        + generateToken(payload: JwtPayload): string
        + verifyToken(token: string): JwtPayload | null
    }

    class EncryptionService {
        + encryptText(plainText: string): Promise<string>
    }
}

' --- RELATIONS ---

' Entry Points -> Use Cases
LoginController ..up-> LoginDto : "receives"
LoginController -down-> LoginUseCase : "invokes"
RegistrationController ..up-> RegistrationDto : "receives"
RegistrationController -down-> RegistrationUseCase : "invokes"
DeleteUserController ..up-> DeleteDto : "receives"
DeleteUserController -down-> DeleteUseCase : "invokes"
GitHubController ..up-> AssociatePatDto : "receives"
GitHubController ..up-> RemovePatDto : "receives"
GitHubController -down-> IAssociatePatUseCase : "invokes"
GitHubController -down-> IRemovePatUseCase : "invokes"

' Responses
LoginController ..up-> AuthResponseDto : "responses"
RegistrationController ..up-> AuthResponseDto : "responses"
DeleteUserController ..up-> DeleteResponseDto : "responses"

' Use Cases implemented by Services
LoginService ..up.|> LoginUseCase
RegistrationService ..up.|> RegistrationUseCase
DeleteService ..up.|> DeleteUseCase
GitHubService ..up.|> IAssociatePatUseCase
GitHubService ..up.|> IRemovePatUseCase

' DTO / Table inheritance
UserDTO -up-|> AccountDTO
GithubTokenDTO -up-|> AccountDTO
UserTable -up-|> DbSchema
GithubTokenTable -up-|> DbSchema
UserMapper -up-|> AccountMapper
GithubTokenMapper -up-|> AccountMapper

' Factory
GithubTokenFactory ..down-> GithubTokenDTO : "creates"
GithubTokenFactory ..down-> IEncryptTextPort : "uses"

' Service -> Output Ports
LoginService --down-> IFindUserByEmailPort 
LoginService --down-> Jwt
LoginService --down-> IComparePort
RegistrationService --down-> IFindUserByEmailPort 
RegistrationService --down-> IUserSaveRepositoryPort
RegistrationService --down-> Jwt
RegistrationService --down-> IHashPort
DeleteService --down-> IUserDeletePort
GitHubService --down-> IGithubClientPort
GitHubService --down-> ISaveTokenPort
GitHubService --down-> IFindTokenByUserIdPort
GitHubService --down-> IDeleteTokenPort
GitHubService --down-> IEncryptTextPort
GitHubService --> GithubTokenFactory : "uses"

' Service <-> Entity / DTO
LoginService ..down-> User : "constructs"
LoginService ..down-> UserDTO : "receives"
RegistrationService ..down-> User : "constructs"
RegistrationService ..down-> UserDTO : "produces"
GitHubService ..down-> GithubToken : "constructs"
GitHubService ..down-> GithubProfileDTO : "receives"

' Postgres Adapter implements ports
PostgresAccountAdapter ..up-|> IFindUserByEmailPort
PostgresAccountAdapter ..up-|> IUserSaveRepositoryPort
PostgresAccountAdapter ..up-|> IUserDeletePort
PostgresAccountAdapter ..up-|> ISaveTokenPort
PostgresAccountAdapter ..up-|> IFindTokenByUserIdPort
PostgresAccountAdapter ..up-|> IDeleteTokenPort

' Postgres Adapter uses Mapper and Table
PostgresAccountAdapter --> UserMapper : "uses"
PostgresAccountAdapter --> GithubTokenMapper : "uses"
PostgresAccountAdapter ..down-> UserTable : "persists"
PostgresAccountAdapter ..down-> GithubTokenTable : "persists"

' Mapper <-> DTO / Table
UserMapper ..down-> UserDTO : "produces"
UserMapper ..down-> UserTable : "produces"
GithubTokenMapper ..down-> GithubTokenDTO : "produces"
GithubTokenMapper ..down-> GithubTokenTable : "produces"

' GitHub Adapter
GitHubAdapter ..up-|> IGithubClientPort
GitHubAdapter --> GithubProfileMapper : "uses"
GitHubAdapter --> GitHubAPI : "GET /user"
GithubProfileMapper ..down-> GitHubAPIResponse : "reads"
GithubProfileMapper ..down-> GithubProfileDTO : "produces"

' Config
ConfigService ..up-|> ConfJwt
ConfigService ..up-|> ConfRounds
ConfigService ..up-|> ConfPostgre
ConfigService ..down-> AWSSSM : "reads secrets at boot"
JwtService --> ConfJwt : "reads JWT_SECRET"
BcryptService --> ConfRounds : "reads BCRYPT_ROUNDS"
PostgresAccountAdapter --> ConfPostgre : "reads DB_URL"

' Crypto implements ports
BcryptService ..up-|> IHashPort
BcryptService ..up-|> IComparePort
JwtService ..up-|> Jwt
EncryptionService ..up-|> IEncryptTextPort

@enduml
