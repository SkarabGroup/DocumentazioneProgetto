@startuml C4_Bedrock_Agents

' --- CONFIGURAZIONE ESTETICA ---
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 90
skinparam classAttributeIconSize 0
hide circles
skinparam class {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 12
}
skinparam interface {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontSize 12
}
skinparam package {
    BorderColor #999999
    BackgroundColor White
}

title C4 Level 4 — Code\nZoom: Bedrock LLM Agent Layer — Lambda Remediation Agents

' ============================================================
' 1. APPLICATION LAYER
' ============================================================
package "Application Layer" {

    enum TaskCategory {
        CODE_REMEDIATION
        DOCS_ANALYSIS
        SECURITY_REMEDIATION
        DEPENDENCY_CVE
        SECRETS_REMEDIATION
        OPENAPI_SIMPLE
        OPENAPI_COMPLEX
        REPORT_AGGREGATION
        ROUTING
    }

    interface ILLMProvider <<Port>> {
        + invoke(systemPrompt: str, userPrompt: str, category: TaskCategory): str
    }

    interface IPromptBuilder <<Port>> {
        + buildSystemPrompt(ctx: dict): str
        + buildUserPrompt(ctx: dict): str
    }

    abstract class RemediationAgentBase <<abstract>> {
        # llmProvider: ILLMProvider
        # promptBuilder: IPromptBuilder
        + {abstract} getTaskCategory(): TaskCategory
        + execute(ctx: dict): RemediationOutput
    }
}

' ============================================================
' 2. DOMAIN LAYER
' ============================================================
package "Domain" {

    class SecurityRemediationAgent {
        + getTaskCategory(): TaskCategory
    }

    class SecretsRemediationAgent {
        + getTaskCategory(): TaskCategory
    }

    class DepsRemediationAgent {
        + getTaskCategory(): TaskCategory
    }

    class OpenAPIRemediationAgent {
        - isComplex: bool
        + getTaskCategory(): TaskCategory
    }

    class ReportAggregatorAgent {
        + getTaskCategory(): TaskCategory
    }
}

' ============================================================
' 3. INFRASTRUCTURE LAYER
' ============================================================
package "Infrastructure" {

    class ModelRouter {
        + resolveModelId(category: TaskCategory): str
    }

    note right of ModelRouter
        CODE_REMEDIATION     → anthropic.claude-sonnet-4-6
        DOCS_ANALYSIS        → anthropic.claude-sonnet-4-6
        SECURITY_REMEDIATION → anthropic.claude-sonnet-4-6
        DEPENDENCY_CVE       → anthropic.claude-3-5-haiku-20241022-v1:0
        SECRETS_REMEDIATION  → anthropic.claude-sonnet-4-6
        OPENAPI_SIMPLE       → amazon.nova-lite-v1:0
        OPENAPI_COMPLEX      → anthropic.claude-sonnet-4-6
        REPORT_AGGREGATION   → anthropic.claude-sonnet-4-6
        ROUTING              → amazon.nova-micro-v1:0
    end note

    class BedrockAdapter {
        - client: BedrockRuntimeClient
        - router: ModelRouter
        + invoke(systemPrompt: str, userPrompt: str, category: TaskCategory): str
    }
}

' ============================================================
' RELAZIONI — INHERITANCE (cross-package)
' ============================================================
SecurityRemediationAgent  --|> RemediationAgentBase
SecretsRemediationAgent   --|> RemediationAgentBase
DepsRemediationAgent      --|> RemediationAgentBase
OpenAPIRemediationAgent   --|> RemediationAgentBase
ReportAggregatorAgent     --|> RemediationAgentBase

' ============================================================
' RELAZIONI — IMPLEMENTS / USES
' ============================================================
BedrockAdapter   ..|>  ILLMProvider         : implements

RemediationAgentBase --> ILLMProvider        : uses
RemediationAgentBase --> IPromptBuilder      : uses
BedrockAdapter       --> ModelRouter         : delegates to
ModelRouter          ..>  TaskCategory       : resolves

@enduml
