    return (
      this._name === other._name &&
      this._pathFinding.equals(other._pathFinding) &&
      this._severity.equals(other._severity)
    );
  }

  public getName(): string {
    return this._name;
  }
  public getPathFinding(): PathFinding {
    return this._pathFinding;
  }
