        VALID_REFERENCED_PATH,
        VALID_REFERENCED_IN,
        VALID_STATUS,
        VALID_DESCRIPTION,
      );

      const m2 = MissingFile.create(
        PathFinding.create('other/path.png'), // Percorso diverso
        VALID_REFERENCED_IN,
        VALID_STATUS,
        VALID_DESCRIPTION,
      );

      expect(m1.equals(m2)).toBe(false);
    });

    it('should throw when comparing with invalid object', () => {
